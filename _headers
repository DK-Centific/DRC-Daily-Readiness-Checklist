# Cloudflare Pages header file. Render applies the same rules from render.yaml
# after a Blueprint sync (Settings → Headers). See the README section
# "Check the security headers". Render's docs do not read this file.

/*
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://*.environment.api.powerplatform.com

/
  Cache-Control: private, no-store
  CDN-Cache-Control: no-store

/index.html
  Cache-Control: private, no-store
  CDN-Cache-Control: no-store

/config.local.json
  Cache-Control: private, no-store
  CDN-Cache-Control: no-store

/config.local.js
  Cache-Control: private, no-store
  CDN-Cache-Control: no-store
